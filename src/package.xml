<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>qr_nav</name>
  <version>1.0.0</version>
  <description>
    QR Code Command Navigation for ROSbot 3 PRO.
    Reads QR codes from the environment and executes encoded navigation
    commands in real time using a finite state machine.
  </description>
  <maintainer email="lintran@nvidia.com">Lin Tran</maintainer>

  <author email="s3999925@rmit.edu.vn">Hoang Minh Thang</author>
  <author email="s3999568@rmit.edu.vn">Truong Ba An</author>
  <author email="s4043097@rmit.edu.vn">Tran Hoang Linh</author>

  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
